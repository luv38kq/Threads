# ------------------------------------------------------------
# このファイルをコピーして「.env.local」という名前で保存し、値を入れてください。
# .env.local は GitHub には送られません（.gitignore 済み）。
# ------------------------------------------------------------

# Supabase の「Project Settings > API」にある値
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Supabase の「secret key」。絶対に他人に見せないでください（サーバーだけで使います）
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 利用者のAPIキーを暗号化するための鍵（32バイトをBase64にしたもの）
# 作り方:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 一度決めたら変更しないでください（変更すると保存済みのAPIキーが読めなくなります）
ENCRYPTION_KEY=

# 公開URL（メール内のリンクなどに使用）。ローカルなら http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
