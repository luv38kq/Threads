# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files の例外（見本ファイルは共有する）
!.env.example

# Cloudflare (OpenNext / wrangler)
.open-next
.wrangler
.dev.vars*
!.dev.vars.example

# DB テスト用の一時フォルダ
/.pgtest

# 拡張機能の配布用zip（ビルド時に自動生成）
/public/downloads

# 画面の動作確認（E2E）の一時フォルダ
/.e2e
